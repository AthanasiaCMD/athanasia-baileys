{
   "name": "@athanasiacmd/baileys",
   "version": "0.7.0",
   "description": "Athanasia Baileys: WhatsApp Web API (Baileys v7 fork) — ESM + signal WASM, interactive messages, album, rich response, console cantik.",
   "main": "lib/index.js",
   "types": "lib/index.d.ts",
   "type": "module",
   "scripts": {
      "build": "node scripts/clean.mjs && tsc -p tsconfig.json",
      "rebrand": "node scripts/rebrand.mjs",
      "check": "node scripts/check.mjs",
      "sync": "node scripts/sync-upstream.mjs",
      "test": "node --test \"test/**/*.test.mjs\"",
      "prepublishOnly": "npm run build && npm run check && npm test",
      "preinstall": "node ./engine-requirements.js"
   },
   "engines": {
      "node": ">=20"
   },
   "repository": {
      "type": "git",
      "url": "git+https://github.com/AthanasiaCMD/athanasia-baileys.git"
   },
   "files": [
      "lib/**/*",
      "WAProto/**/*",
      "engine-requirements.js",
      "NOTICE.md",
      "CHANGELOG.md"
   ],
   "keywords": [
      "athanasia",
      "automation",
      "baileys",
      "bot",
      "interactive-messages",
      "js-whatsapp",
      "multi-device",
      "typescript",
      "whatsapp",
      "whatsapp-api",
      "whatsapp-bot",
      "whatsapp-web"
   ],
   "homepage": "https://www.npmjs.com/package/@athanasiacmd/baileys",
   "author": "AthanasiaCMD",
   "license": "MIT",
   "dependencies": {
      "whatsapp-rust-bridge": "0.5.5",
      "qr": ">=0.5.0"
   },
   "peerDependencies": {
      "@napi-rs/image": "^1.12.0",
      "better-sqlite3": ">=11.0.0",
      "jimp": "^1.6.0",
      "sharp": ">=0.33.0",
      "ws": "^8.13.0"
   },
   "peerDependenciesMeta": {
      "@napi-rs/image": {
         "optional": true
      },
      "better-sqlite3": {
         "optional": true
      },
      "jimp": {
         "optional": true
      },
      "sharp": {
         "optional": true
      },
      "ws": {
         "optional": true
      }
   },
   "resolutions": {
      "ajv@npm:^6.12.4": "^6.14.0",
      "basic-ftp": "^5.2.4",
      "brace-expansion@npm:^1.1.7": "^1.1.13",
      "brace-expansion@npm:^2.0.1": "^2.0.3",
      "flatted": "^3.4.2",
      "glob@npm:^10.2.2": "^10.5.0",
      "glob@npm:^10.3.10": "^10.5.0",
      "glob@npm:^10.5.0": "^10.5.0",
      "handlebars": "^4.7.9",
      "ip-address": "^10.1.1",
      "js-yaml@npm:^3.13.1": "^3.14.2",
      "js-yaml@npm:^4.1.0": "^4.1.1",
      "markdown-it": "^14.1.1",
      "minimatch@npm:^3.0.4": "^3.1.5",
      "minimatch@npm:^3.1.2": "^3.1.5",
      "minimatch@npm:^5.0.1": "^5.1.8",
      "minimatch@npm:^9.0.4": "^9.0.9",
      "minimatch@npm:^9.0.5": "^9.0.9",
      "picomatch@npm:^2.0.4": "^2.3.2",
      "picomatch@npm:^2.3.1": "^2.3.2",
      "picomatch@npm:^4.0.0": "^4.0.4",
      "picomatch@npm:^4.0.2": "^4.0.4",
      "socks": "^2.8.8",
      "tar": "^7.5.11",
      "tmp": "^0.2.5",
      "underscore": "^1.13.8",
      "yaml@npm:^2.6.1": "^2.8.4"
   },
   "packageManager": "yarn@4.9.2",
   "devDependencies": {
      "typescript": "^5.8.2",
      "@types/node": "^22.0.0"
   },
   "exports": {
      ".": {
         "types": "./lib/index.d.ts",
         "import": "./lib/index.js",
         "default": "./lib/index.js"
      },
      "./package.json": "./package.json"
   },
   "sideEffects": false,
   "publishConfig": {
      "access": "public"
   }
}

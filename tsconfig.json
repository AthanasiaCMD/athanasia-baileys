{
   "compilerOptions": {
      "target": "ES2022",
      "module": "NodeNext",
      "moduleResolution": "NodeNext",
      "rootDir": "src",
      "rootDirs": ["src", "lib"],
      "outDir": "lib",
      "declaration": true,
      "strict": true,
      "skipLibCheck": true,
      "esModuleInterop": true,
      "types": ["node"]
   },
   "include": ["src/**/*.ts"]
}
